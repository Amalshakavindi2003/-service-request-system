@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --bg-900: #041226;
  --bg-800: #071226;
  --surface: #071023;
  --card: rgba(11,18,32,0.6);
  --glass: rgba(255,255,255,0.03);
  --primary-500: #6366f1;
  --primary-600: #4f46e5;
  --accent-500: #06b6d4;
  --text: #e6eef8;
  --muted: #9aa6b2;
  --border: rgba(255,255,255,0.06);
}

html, body, #root { height: 100%; }

body {
  background: radial-gradient(1200px 400px at 10% 10%, rgba(79,70,229,0.06), transparent 8%),
              radial-gradient(900px 300px at 90% 90%, rgba(6,182,212,0.03), transparent 10%),
              linear-gradient(180deg, var(--bg-900), var(--bg-800));
  color: var(--text);
  font-family: Inter, 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', Arial;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

/* Page shells */
.grid.min-h-screen { min-height: 100vh; }

/* Centered card for auth pages */
.auth-wrap { display:flex; align-items:center; justify-content:center; min-height:100vh; padding:2rem; }

/* App container */
.app-container { display:flex; min-height:100vh; }

/* Sidebar */
.sidebar {
  width: 260px;
  background: linear-gradient(180deg, rgba(6,16,30,0.95), rgba(8,18,34,0.95));
  border-right: 1px solid var(--border);
  padding: 1.25rem 1rem;
}
.sidebar .brand { font-weight:800; font-size:1.25rem; color:var(--primary-500); margin-bottom:1rem; }
.sidebar nav a { display:block; padding:0.5rem 0.6rem; color:var(--text); border-radius:10px; margin-bottom:0.35rem; text-decoration:none; }
.sidebar nav a:hover { background: rgba(99,102,241,0.06); color:var(--primary-500); }
.sidebar nav a.active { background: linear-gradient(90deg, rgba(99,102,241,0.12), rgba(6,182,212,0.06)); color:var(--primary-500); font-weight:600; }

/* Main area */
.main { flex:1; padding:2rem; }
.header { display:flex; justify-content:space-between; align-items:center; margin-bottom:1.25rem; }
.header h1 { font-size:1.85rem; margin:0; }

/* Elegant card */
.card {
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
  backdrop-filter: blur(6px) saturate(120%);
  -webkit-backdrop-filter: blur(6px) saturate(120%);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1rem;
  box-shadow: 0 8px 30px rgba(2,6,23,0.55);
}

/* Form layout */
.card.wide { padding:0; overflow:hidden; }
.auth-card-header { padding:1.25rem 1.25rem; background: linear-gradient(90deg, var(--primary-600), var(--primary-500)); }
.auth-card-body { padding:1.25rem; background: linear-gradient(180deg, rgba(7,16,34,0.65), rgba(6,10,20,0.5)); }

/* Buttons */
.btn { display:inline-flex; align-items:center; justify-content:center; gap:8px; padding:0.6rem 0.95rem; border-radius:12px; cursor:pointer; border:none; }
.btn:focus { outline: none; }
.btn-primary {
  background: linear-gradient(90deg, var(--primary-600), var(--primary-500));
  color: white; font-weight:700; box-shadow: 0 10px 30px rgba(79,70,229,0.12);
  transition: transform .12s ease, box-shadow .12s ease;
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 14px 40px rgba(79,70,229,0.14); }
.btn-outline { background: transparent; border:1px solid rgba(255,255,255,0.05); color:var(--text); padding:0.5rem 0.8rem; }

/* Inputs */
.input, textarea, select {
  width:100%; padding:0.7rem 0.9rem; border-radius:10px; border:1px solid rgba(255,255,255,0.04);
  background: rgba(11,18,32,0.45); color:var(--text); transition: box-shadow .12s ease, border-color .12s ease;
}
.input:focus, textarea:focus, select:focus { outline:none; border-color: rgba(99,102,241,0.9); box-shadow: 0 6px 20px rgba(79,70,229,0.06); }

/* Demo box */
.demo-box { border-radius:10px; padding:0.9rem; border:1px solid rgba(99,102,241,0.08); background: linear-gradient(90deg, rgba(99,102,241,0.03), rgba(6,182,212,0.02)); color:var(--text); }
.demo-actions { display:flex; gap:0.5rem; margin-top:0.6rem; }

/* Stats cards */
.stat-card { padding:1rem; border-radius:16px; color:white; box-shadow: 0 8px 24px rgba(2,6,23,0.45); }

/* Table */
.table { width:100%; border-collapse:collapse; }
.table th, .table td { padding:0.85rem 1rem; border-bottom:1px solid rgba(255,255,255,0.03); }
.table th { text-transform:uppercase; color:var(--muted); font-size:0.82rem; }
.table tbody tr:hover { background: rgba(255,255,255,0.02); }

/* Small helpers */
.text-muted { color:var(--muted); }
.rounded-xl { border-radius:12px; }

@media (max-width: 768px) {
  .sidebar { display:none; }
  .main { padding:1rem; }
}

/* Sidebar refinements for colorful grouped navigation */
.sidebar { padding: 1.5rem 0.9rem; }
.nav-section { margin-bottom: 1.1rem; padding: 0 0.25rem; }
.nav-section-title { display:block; font-size:0.75rem; color:rgba(255,255,255,0.45); text-transform:uppercase; font-weight:700; margin:0 0 0.5rem 0.25rem; letter-spacing:0.6px; }
.nav-item { display:flex; align-items:center; gap:0.7rem; padding:0.55rem 0.6rem; color:var(--text); border-radius:10px; margin-bottom:0.35rem; text-decoration:none; transition:background .12s, transform .08s; }
.nav-item .icon { width:28px; height:28px; display:inline-grid; place-items:center; border-radius:8px; background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); box-shadow:inset 0 -6px 14px rgba(2,6,23,0.2); }
.nav-item:hover { background: rgba(99,102,241,0.06); transform: translateX(4px); }
.nav-item.active { background: linear-gradient(90deg, rgba(99,102,241,0.12), rgba(6,182,212,0.06)); color:var(--primary-500); font-weight:700; box-shadow: 0 8px 24px rgba(2,6,23,0.45); }
.sidebar .logout { margin-top:1rem; padding:0.5rem; display:block; border-radius:8px; background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border:1px solid rgba(255,255,255,0.03); color:var(--text); text-align:center; }
.sidebar .logout:hover { transform: translateX(3px); }


/* Inject visual section headings into existing nav using pseudo-elements */
.sidebar nav { padding-top: 0.25rem; }
.sidebar nav a { position: relative; padding-left: 0.6rem; }
.sidebar nav a::before { content: ''; display: block; font-size: 0.75rem; color: transparent; margin-bottom: 0.35rem; }
.sidebar nav a:nth-child(1)::before { content: 'Main'; color: rgba(255,255,255,0.45); font-weight:700; text-transform:uppercase; letter-spacing:0.6px; margin-left:0.25rem; }
.sidebar nav a:nth-child(3)::before { content: 'Requests'; color: rgba(255,255,255,0.45); font-weight:700; text-transform:uppercase; letter-spacing:0.6px; margin-left:0.25rem; }
.sidebar nav a:nth-child(5)::before { content: 'Support'; color: rgba(255,255,255,0.45); font-weight:700; text-transform:uppercase; letter-spacing:0.6px; margin-left:0.25rem; }
.sidebar nav a:nth-child(7)::before { content: 'Account'; color: rgba(255,255,255,0.45); font-weight:700; text-transform:uppercase; letter-spacing:0.6px; margin-left:0.25rem; }
/* Make icons boxed */
.sidebar nav a span:first-child { display:inline-grid; place-items:center; width:28px; height:28px; border-radius:8px; background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); margin-right:0.6rem; }
.sidebar nav a { transition: transform .12s, background .12s; }


